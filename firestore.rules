rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Anonymous (guest) sessions use the 'anonymous' sign-in provider. Guests
    // keep their data in AsyncStorage only; it migrates to Firestore on sign-in.
    function isNotAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A participant and everything under it belongs to a single user.
    match /participants/{userId}/{document=**} {
      allow read: if isOwner(userId);
      // Only authenticated (email/password or Google) owners may write.
      allow write: if isOwner(userId) && isNotAnonymous();
    }

    // Everything else is denied by default (admin collections are written
    // server-side via the Admin SDK, which bypasses these rules).
  }
}

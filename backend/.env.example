# === Shared configuration (non-sensitive, deployed with functions) ===
APP_PORT=4000
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
CORS_ORIGIN=http://localhost:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# === Required but never commit — create .env.local ===
# CLIENT_FIREBASE_API_KEY=your-firebase-web-api-key
# GEMINI_API_KEY=your-gemini-api-key
# LOCAL_GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

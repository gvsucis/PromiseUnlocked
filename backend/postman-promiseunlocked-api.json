{
  "info": {
    "_postman_id": "promiseunlocked-api-collection",
    "name": "PromiseUnlocked API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Save idToken as Bearer token",
              "if (pm.response.code === 200) {",
              "  var data = pm.response.json();",
              "  if (data.idToken) {",
              "    pm.environment.set('bearerToken', data.idToken);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "List Participants",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/participants",
          "host": ["{{baseUrl}}"],
          "path": ["api", "participants"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Set the first participantId as an environment variable",
              "if (pm.response.code === 200) {",
              "  var data = pm.response.json();",
              "  if (data.participants && data.participants.length > 0) {",
              "    pm.environment.set('participantId', data.participants[0].uid);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Participant",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/participants/{{participantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "participants", "{{participantId}}"]
        }
      },
      "response": []
    },
    {
      "name": "List Sessions for Participant",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/participants/{{participantId}}/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "participants", "{{participantId}}", "sessions"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Set the first sessionId as an environment variable",
              "if (pm.response.code === 200) {",
              "  var data = pm.response.json();",
              "  if (data.sessions && data.sessions.length > 0) {",
              "    pm.environment.set('sessionId', data.sessions[0].id);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Session",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/participants/{{participantId}}/sessions/{{sessionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "participants", "{{participantId}}", "sessions", "{{sessionId}}"]
        }
      },
      "response": []
    },
    {
      "name": "List Interactions for Session",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/participants/{{participantId}}/sessions/{{sessionId}}/interactions",
          "host": ["{{baseUrl}}"],
          "path": [
            "api",
            "participants",
            "{{participantId}}",
            "sessions",
            "{{sessionId}}",
            "interactions"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  var data = pm.response.json();",
              "  if (data.interactions && data.interactions.length > 0) {",
              "    pm.environment.set('interactionId', data.interactions[0].id);",
              "  }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Get Interaction",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/participants/{{participantId}}/sessions/{{sessionId}}/interactions/{{interactionId}}",
          "host": ["{{baseUrl}}"],
          "path": [
            "api",
            "participants",
            "{{participantId}}",
            "sessions",
            "{{sessionId}}",
            "interactions",
            "{{interactionId}}"
          ]
        }
      },
      "response": []
    }
  ],
  "event": [],
  "variable": [{ "key": "baseUrl", "value": "http://localhost:4000" }]
}
